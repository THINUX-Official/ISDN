@model ISDN.ViewModels.CustomerManagementViewModel
@{
    ViewData["Title"] = "Manage Customer Clusters";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="fas fa-users-cog"></i> Customer Cluster Management</h2>
            <p class="text-muted">Manage PBOS and PBOM cluster details without affecting their order or payment history.</p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white border-bottom-0 pb-0 pt-3">
            <ul class="nav nav-tabs" id="clusterTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="pbos-tab" data-bs-toggle="tab" data-bs-target="#pbos" type="button" role="tab" aria-controls="pbos" aria-selected="true">
                        <i class="fas fa-store"></i> Single-Branch Owners (PBOS)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pbom-tab" data-bs-toggle="tab" data-bs-target="#pbom" type="button" role="tab" aria-controls="pbom" aria-selected="false">
                        <i class="fas fa-network-wired"></i> Multi-Branch Owners (PBOM)
                    </button>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="tab-content" id="clusterTabsContent">
                <!-- PBOS Tab -->
                <div class="tab-pane fade show active" id="pbos" role="tabpanel" aria-labelledby="pbos-tab">
                    @await Html.PartialAsync("_CustomerTable", Model.PbósCustomers)
                </div>

                <!-- PBOM Tab -->
                <div class="tab-pane fade" id="pbom" role="tabpanel" aria-labelledby="pbom-tab">
                    @await Html.PartialAsync("_CustomerTable", Model.PbómCustomers)
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editCustomerModal" tabindex="-1" aria-labelledby="editCustomerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="editCustomerModalLabel"><i class="fas fa-edit me-2"></i> Edit Cluster Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editCustomerForm">
                    <input type="hidden" id="editCustomerId" name="customerId" />

                    <div class="alert alert-warning py-2 mb-3">
                        <i class="fas fa-exclamation-triangle"></i> Changing these details will not affect the customer's login, orders, or payment history.
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Business Type</label>
                            <input type="text" class="form-control" id="editBusinessType" name="businessType" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Business Name</label>
                            <input type="text" class="form-control" id="editBusinessName" name="businessName" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Branch Name</label>
                            <input type="text" class="form-control" id="editBranchName" name="branchName" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Assigned RDC</label>
                            <select class="form-select" id="editRdcId" name="rdcId">
                                <option value="">-- Unassigned --</option>
                                @foreach (var rdc in Model.AvailableRdcs)
                                {
                                    <option value="@rdc.Value">@rdc.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                    
                    <h6 class="mt-3 mb-2 text-secondary fw-bold border-bottom pb-2">Physical Location</h6>
                    
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">Street Address</label>
                            <input type="text" class="form-control" id="editStreetAddress" name="streetAddress" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">City</label>
                            <input type="text" class="form-control" id="editCity" name="city" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Zip Code</label>
                            <input type="text" class="form-control" id="editZipCode" name="zipCode" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary px-4" id="saveBtn" onclick="saveCustomer()">
                    <i class="fas fa-save me-2"></i> Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const editModal = new bootstrap.Modal(document.getElementById('editCustomerModal'));

        function openEditModal(customerStr) {
            const customer = JSON.parse(decodeURIComponent(customerStr));
            
            document.getElementById('editCustomerId').value = customer.CustomerId;
            document.getElementById('editBusinessType').value = customer.BusinessType || '';
            document.getElementById('editBusinessName').value = customer.BusinessName || '';
            document.getElementById('editBranchName').value = customer.BranchName || '';
            document.getElementById('editStreetAddress').value = customer.StreetAddress || '';
            document.getElementById('editCity').value = customer.City || '';
            document.getElementById('editZipCode').value = customer.ZipCode || '';
            document.getElementById('editRdcId').value = customer.RdcId || '';

            editModal.show();
        }

        async function saveCustomer() {
            var form = document.getElementById('editCustomerForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            var btn = document.getElementById('saveBtn');
            var originalText = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Saving...';
            btn.disabled = true;

            const url = '@Url.Action("UpdateCustomer", "CustomerAdmin")';
            const formData = new FormData(form);

            try {
                const response = await fetch(url, {
                    method: 'POST',
                    body: formData
                });
                
                const result = await response.json();
                if(result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Updated',
                        text: result.message,
                        showConfirmButton: false,
                        timer: 1500
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire('Error', result.message, 'error');
                }
            } catch(e) {
                Swal.fire('Error', 'An unexpected error occurred.', 'error');
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }
    </script>
}