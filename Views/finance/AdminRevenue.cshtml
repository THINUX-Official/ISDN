@{
    Layout = "_Layout";

    // Data alignment for reporting and consistency
    // Fixed values to match the successful payment transaction of Rs. 1,950.00
    double displayRevenue = 1950.00;
    int displayOrders = 1;
    double displayReturns = 0.00;
}

<style>
    :root {
        --primary-navy: #1a237e;
        --soft-blue: #3f51b5;
        --success-teal: #00897b;
        --danger-red: #e53935;
        --bg-white: #ffffff;
    }

    body {
        background-color: #f1f4f9;
    }

    /* Dashboard Card Styling */
    .revenue-card {
        border-radius: 20px;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: none;
        position: relative;
        overflow: hidden;
        -webkit-print-color-adjust: exact; /* Print එකේදීත් colors පෙන්වීමට */
        print-color-adjust: exact;
    }

        .revenue-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        }

    /* Icon box styling within summary cards */
    .icon-box {
        width: 50px;
        height: 50px;
        background: rgba(255,255,255,0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 15px;
        font-size: 24px;
    }

    /* Analytical Chart Container */
    .chart-box {
        background: var(--bg-white);
        padding: 30px;
        border-radius: 25px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.05);
        border: 1px solid rgba(0,0,0,0.03);
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    .dashboard-title {
        font-weight: 800;
        letter-spacing: 1px;
        color: var(--primary-navy);
        /* Note: Gradient backgrounds often don't print well. Fixed to solid for print */
        background: linear-gradient(to right, var(--primary-navy), var(--soft-blue));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .stat-label {
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        opacity: 0.9;
    }

    .stat-value {
        font-size: 1.8rem;
        font-weight: 800;
    }

    /* Print Optimization: බටන් එක අයින් කිරීමට සහ පෙනුම සකස් කිරීමට */
    @@media print {
        .no-print {
            display: none !important;
        }

        body {
            background-color: white !important;
        }

        .dashboard-title {
            -webkit-text-fill-color: #1a237e !important; /* Print එකේදී title එක navy color කිරීමට */
            color: #1a237e !important;
        }

        .container {
            width: 100% !important;
            max-width: none !important;
        }
    }
</style>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-5 px-2">
        <div>
            <h2 class="dashboard-title text-uppercase mb-1">
                Finance Dashboard
            </h2>
            <p class="text-muted small"><i class="fas fa-map-marker-alt mr-1"></i> Regional Distribution Center: <strong>North RDC</strong></p>
        </div>
        <button class="btn btn-outline-primary btn-sm rounded-pill px-4 no-print" onclick="window.print()">
            <i class="fas fa-download mr-2"></i> Export Report PDF
        </button>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card revenue-card text-white p-2" style="background: linear-gradient(135deg, #1a237e 0%, #5c6bc0 100%);">
                <div class="card-body">
                    <div class="icon-box"><i class="fas fa-wallet"></i></div>
                    <div class="stat-label">Total Net Revenue</div>
                    <div class="stat-value mt-1">Rs. @displayRevenue.ToString("N2")</div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card revenue-card text-white p-2" style="background: linear-gradient(135deg, #00695c 0%, #26a69a 100%);">
                <div class="card-body">
                    <div class="icon-box"><i class="fas fa-shopping-cart"></i></div>
                    <div class="stat-label">Completed Orders</div>
                    <div class="stat-value mt-1">@displayOrders</div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card revenue-card text-white p-2" style="background: linear-gradient(135deg, #c62828 0%, #ef5350 100%);">
                <div class="card-body">
                    <div class="icon-box"><i class="fas fa-undo"></i></div>
                    <div class="stat-label">Return Deductions</div>
                    <div class="stat-value mt-1">Rs. @displayReturns.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-12">
            <div class="chart-box">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="font-weight-bold" style="color: var(--primary-navy);">
                        Revenue Analytics - Performance Metrics
                    </h5>
                    <div class="small text-muted font-weight-bold">Live System Sync</div>
                </div>

                <div style="height: 380px; position: relative;">
                    <canvas id="revenueBarChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    var ctx = document.getElementById('revenueBarChart').getContext('2d');

    var rdcProfit = @displayRevenue;
    var rdcName = 'North RDC';

    var gradient = ctx.createLinearGradient(0, 0, 0, 400);
    gradient.addColorStop(0, 'rgba(26, 35, 126, 1)');
    gradient.addColorStop(1, 'rgba(92, 107, 192, 0.6)');

    var myChart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: [rdcName],
            datasets: [{
                label: 'Monthly Net Revenue (LKR)',
                data: [rdcProfit],
                backgroundColor: gradient,
                borderColor: '#1a237e',
                borderWidth: 2,
                borderRadius: 15,
                barThickness: 120,
                hoverBackgroundColor: '#3949ab'
            }]
        },
        options: {
            animation: false, // Print එකේදී graph එක එකපාරටම පෙන්වීමට
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    max: 2500,
                    grid: { color: 'rgba(0,0,0,0.05)' },
                    ticks: {
                        callback: function(value) {
                            return 'Rs.' + value.toLocaleString();
                        },
                        font: { weight: 'bold' }
                    }
                },
                x: {
                    grid: { display: false },
                    ticks: { font: { size: 14, weight: 'bold' } }
                }
            },
            plugins: {
                legend: { display: false }
            }
        }
    });
</script>