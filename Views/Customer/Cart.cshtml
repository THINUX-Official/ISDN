@model IEnumerable<ISDN.Models.CartItemViewModel>

@{
    ViewData["Title"] = "Your Cart";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2><i class="fas fa-shopping-cart text-primary"></i> Your Cart</h2>
            <p class="text-muted">Review your items before proceeding to checkout.</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-controller="Customer" asp-action="Products" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Continue Shopping
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                        <h5 class="fw-bold mb-0">Cart Items (@Model.Sum(x => x.Quantity))</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col" style="width: 50%">Product</th>
                                        <th scope="col" class="text-center">Price</th>
                                        <th scope="col" class="text-center">Quantity</th>
                                        <th scope="col" class="text-end">Total</th>
                                        <th scope="col" class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                                                    {
                                                        <img src="@item.ProductImageUrl" class="img-thumbnail me-3 p-1"
                                                            style="width: 60px; height: 60px; object-fit: contain;"
                                                            alt="@item.ProductName">
                                                    }
                                                    else
                                                    {
                                                        <div class="bg-light text-secondary d-flex justify-content-center align-items-center img-thumbnail me-3"
                                                            style="width: 60px; height: 60px;">
                                                            <i class="fas fa-box"></i>
                                                        </div>
                                                    }
                                                    <span class="fw-semibold">@item.ProductName</span>
                                                </div>
                                            </td>
                                            <td class="text-center text-muted">LKR @item.UnitPrice.ToString("N2")</td>
                                            <td class="text-center"><span
                                                    class="badge bg-primary rounded-pill px-3 py-2">@item.Quantity</span></td>
                                            <td class="text-end fw-bold text-dark">LKR @item.Total.ToString("N2")</td>
                                            <td class="text-center">
                                                <form asp-controller="Customer" asp-action="RemoveFromCart" method="post"
                                                    class="d-inline">
                                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        title="Remove Item">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0 bg-light">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4 border-bottom pb-3">Order Summary</h5>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Subtotal</span>
                            <span class="fw-semibold">LKR @Model.Sum(x => x.Total).ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Tax / VAT</span>
                            <span class="fw-semibold">Calculated at dispatch</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="text-muted">Shipping</span>
                            <span class="fw-semibold text-success">Free Courier</span>
                        </div>

                        <div class="border-top pt-3 mt-3 mb-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold fs-5">Total Estimated</span>
                                <span class="fw-bold fs-4 text-primary">LKR @Model.Sum(x => x.Total).ToString("N2")</span>
                            </div>
                        </div>

                        <form asp-controller="Customer" asp-action="Payment" method="get">
                            <button type="submit" class="btn btn-success btn-lg w-100 fw-bold shadow-sm">
                                <i class="fas fa-check-circle me-2"></i> Submit Order
                            </button>
                        </form>

                        <p class="text-center text-muted small mt-3 mb-0">
                            By placing your order, you agree to ISDN Terms of Service and Privacy Policy.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12 mt-4">
                <div class="card border-0 shadow-sm text-center py-5">
                    <div class="card-body">
                        <i class="fas fa-shopping-cart fa-5x text-secondary opacity-50 mb-4"></i>
                        <h3 class="fw-bold">Your cart is empty</h3>
                        <p class="text-muted mb-4 fs-5">Looks like you haven't added anything to your cart yet.</p>
                        <a asp-controller="Customer" asp-action="Products" class="btn btn-primary btn-lg px-5 rounded-pill">
                            <i class="fas fa-search me-2"></i> Start Shopping
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>