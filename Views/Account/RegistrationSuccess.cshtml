@{
    ViewData["Title"] = "Registration Successful";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string? generatedCode = ViewBag.GeneratedCode as string;
}

<div class="auth-page-wrapper">
    <div class="auth-container">
        <div class="auth-card text-center">
            <div class="mb-4">
                <i class="fas fa-check-circle text-success" style="font-size: 4rem;"></i>
            </div>

            <h1 class="auth-title">Registration Submitted!</h1>
            <p class="auth-subtitle">Your multi-branch registration is now pending approval.</p>

            @if (!string.IsNullOrEmpty(generatedCode))
            {
                <div class="code-display-box my-4">
                    <p class="text-muted mb-2">Your Manager Access Code:</p>
                    <h2 class="display-4 font-weight-bold text-primary">@generatedCode</h2>
                </div>

                <div class="info-note-warning mb-4">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span>
                        <strong>IMPORTANT:</strong> This is a one-time code. Please write it down or save it now.
                        You will need this to retrieve branch details for manager registration.
                        It cannot be retrieved later for security reasons.
                    </span>
                </div>
            }
            else
            {
                <div class="info-note-turquoise mb-4">
                    <i class="fas fa-info-circle"></i>
                    <span>Your account is being reviewed. You can log in with your email once approved.</span>
                </div>
            }

            <hr />

            <div class="mt-4">
                <a asp-action="Login" class="btn-auth-submit text-decoration-none d-inline-block">
                    <i class="fas fa-arrow-left me-2"></i> Back to Login
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .code-display-box {
        background: #f8f9fa;
        border: 2px dashed #764ba2;
        border-radius: 10px;
        padding: 20px;
    }

    .info-note-warning {
        background: #fff3cd;
        border-left: 4px solid #ffc107;
        padding: 15px;
        border-radius: 4px;
        font-size: 0.9rem;
        color: #856404;
        text-align: left;
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    /* Reuse your existing auth styles or ensure they are in your main CSS */
    .auth-page-wrapper {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .auth-card {
        background: #fff;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        max-width: 500px;
        width: 100%;
    }
</style>
