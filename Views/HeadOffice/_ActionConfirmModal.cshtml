<div class="modal fade" id="actionConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="actionConfirmModalTitle">Confirm Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>You're about to perform this action on <strong><span id="actionConfirmCount">0</span></strong> branch(es):</p>
                <ul id="actionConfirmList" class="mb-3"></ul>
                <input type="hidden" id="actionConfirmCluster" />
                <input type="hidden" id="actionConfirmType" />
                <div class="alert alert-warning">If you suspend the main branch only, the system disallows it. Select other branches or choose whole cluster instead.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="actionConfirmProceed">Proceed</button>
            </div>
        </div>
    </div>
</div>