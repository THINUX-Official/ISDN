@model ISDN.Models.DriverDashboardViewModel

<div class="container-fluid py-4 bg-light min-vh-100">
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary text-white text-center p-3">
                <h6 class="text-uppercase small fw-bold opacity-75">Today's Tasks</h6>
                <h2 class="mb-0">@Model.TodayCount</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-warning text-dark text-center p-3">
                <h6 class="text-uppercase small fw-bold opacity-75">Pending Shipment</h6>
                <h2 class="mb-0">@Model.PendingCount</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success text-white text-center p-3">
                <h6 class="text-uppercase small fw-bold opacity-75">Done Today</h6>
                <h2 class="mb-0">@Model.CompletedTodayCount</h2>
            </div>
        </div>
    </div>

    <ul class="nav nav-pills nav-fill mb-4 bg-white rounded shadow-sm p-1" id="driverTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active fw-bold" id="tracking-tab" data-bs-toggle="tab" data-bs-target="#tracking" type="button">
                <i class="fas fa-map-marked-alt me-2"></i>Live Tracking
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold" id="history-tab" data-bs-toggle="tab" data-bs-target="#history" type="button">
                <i class="fas fa-history me-2"></i>Delivery History
            </button>
        </li>
    </ul>

    <div class="tab-content" id="driverTabContent">
        <div class="tab-pane fade show active" id="tracking" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4" style="height: 400px;">
                <div class="bg-dark text-white px-3 py-2 d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-compass fa-spin me-2"></i> Tracking: <span id="currentTrackingNum">Select an Order below</span></span>
                    <small>Auto-updating from delivery address</small>
                </div>
                <iframe id="giantMap" width="100%" height="100%" frameborder="0" style="border:0"
                        src="https://maps.google.com/maps?q=Sri+Lanka&t=&z=7&ie=UTF8&iwloc=&output=embed" allowfullscreen>
                </iframe>
            </div>

            <div class="row g-3">
                <div class="col-12"><h5 class="fw-bold mb-3">Active Deliveries</h5></div>
                @foreach (var delivery in Model.ActiveDeliveries)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm h-100 list-group-item">
                            <div class="card-body">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="fw-bold text-primary">#@delivery.Order.OrderNumber</span>
                                    <span class="badge bg-info text-dark">@delivery.Status</span>
                                </div>
                                <h6 class="fw-bold mb-1">@delivery.Order.Customer.business_name</h6>
                                <p class="small text-muted mb-3"><i class="fas fa-map-pin me-1"></i>@delivery.Order.DeliveryAddress</p>

                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-primary flex-grow-1"
                                            onclick="updateMap('@delivery.Order.DeliveryAddress', '@delivery.Order.OrderNumber')">
                                        <i class="fas fa-location-arrow"></i> Track
                                    </button>
                                    <a href="tel:@delivery.Order.Customer.phone_number" class="btn btn-sm btn-outline-secondary">
                                        <i class="fas fa-phone"></i>
                                    </a>
                                    <form asp-action="MarkAsDelivered" method="post" class="flex-grow-1">
                                        <input type="hidden" name="deliveryId" value="@delivery.DeliveryId" />
                                        <button type="submit" class="btn btn-sm btn-success w-100">
                                            <i class="fas fa-check"></i> Deliver
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="tab-pane fade" id="history" role="tabpanel">
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Order #</th>
                                <th>Customer</th>
                                <th>Delivered At</th>
                                <th class="text-end pe-4">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var history in Model.CompletedDeliveries)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@history.Order.OrderNumber</td>
                                    <td>
                                        <div class="fw-bold">@history.Order.Customer.business_name</div>
                                        <small class="text-muted">@history.Order.DeliveryAddress</small>
                                    </td>
                                    <td>@history.DeliveryDate?.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td class="text-end pe-4">
                                        <span class="badge bg-success-subtle text-success border border-success px-3 py-2">
                                            <i class="fas fa-check-circle me-1"></i> COMPLETED
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
                     function updateMap(address, orderNum) {
            const mapIframe = document.getElementById('giantMap');

            // 1. Clean the address and append Sri Lanka to force the correct region
            const cleanAddress = address.replace(/[#]/g, ""); // Remove # characters if any
            const query = encodeURIComponent(cleanAddress + ", Sri Lanka");

            // 2. USE THIS EXACT URL FORMAT (No API Key Required)
            // t=m (roadmap), z=17 (high zoom), q= (query)
            const mapUrl = `https://maps.google.com/maps?q=${query}&t=m&z=17&output=embed`;

            // 3. Update the iframe source
            mapIframe.src = mapUrl;

            // 4. Update the text label
            document.getElementById('currentTrackingNum').innerText = "#" + orderNum;

            // 5. Scroll up so the driver can see the map update
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
        }
    </script>
}

<style>
    .nav-pills .nav-link { color: #6c757d; border: 1px solid transparent; }
    .nav-pills .nav-link.active { background-color: #0d6efd; color: white; }
    .list-group-item { border-left: 4px solid transparent; }
    .list-group-item:hover { border-left-color: #0d6efd; background-color: #f8f9fa; }
    .bg-success-subtle { background-color: #d1e7dd; }
</style>