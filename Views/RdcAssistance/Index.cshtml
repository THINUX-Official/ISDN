@model ISDN.ViewModels.RdcPackRequestViewModel
@{
    ViewData["Title"] = "Request Cross-RDC Packing Assistance";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="fas fa-people-carry"></i> Request RDC Packing Assistance</h2>
            <p class="text-muted">Request another Regional Distribution Center to pack pending orders.</p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h4 class="card-title mb-4">Local Pending Orders (Status: PLACED)</h4>
            
            @if (Model.PendingOrders.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Order Number</th>
                                <th>Date</th>
                                <th>Customer</th>
                                <th>Items Overview</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.PendingOrders)
                            {
                                <tr>
                                    <td><strong>@order.OrderNumber</strong></td>
                                    <td>@order.OrderDate.ToString("g")</td>
                                    <td>@order.CustomerName</td>
                                    <td>
                                        <ul class="list-unstyled mb-0 mb-1 small">
                                            @foreach (var item in order.Items.Take(2))
                                            {
                                                <li>@item.Quantity x @item.ProductName</li>
                                            }
                                        </ul>
                                        @if(order.Items.Count > 2)
                                        {
                                            <span class="badge bg-secondary">+ @(order.Items.Count - 2) more items</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-primary btn-sm rounded-pill px-3" onclick="openRequestModal(@order.OrderId, '@order.OrderNumber', @Html.Raw(Json.Serialize(order.Items)))">
                                            <i class="fas fa-paper-plane me-1"></i> Request Assistance
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info py-4 text-center mb-0">
                    <i class="fas fa-check-circle fa-2x mb-3 text-info"></i><br/>
                    <h5>No Pending Orders Found</h5>
                    <p class="mb-0 text-muted">You do not currently have any orders stuck in PLACED status.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Request Modal -->
<div class="modal fade" id="requestModal" tabindex="-1" aria-labelledby="requestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="requestModalLabel"><i class="fas fa-envelope-open-text me-2"></i> Send Packing Request</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="assistanceForm">
                    <input type="hidden" id="selectedOrderId" />
                    
                    <div class="mb-4">
                        <label for="targetRdc" class="form-label fw-bold">Select Target RDC</label>
                        <select id="targetRdc" class="form-select border-primary cursor-pointer shadow-none py-2" required>
                            <option value="">-- Choose an RDC --</option>
                            @foreach (var rdc in Model.TargetRdcs)
                            {
                                <option value="@rdc.Value">@rdc.Text</option>
                            }
                        </select>
                        <div class="form-text mt-1"><i class="fas fa-info-circle"></i> We will email all Admins at this location.</div>
                    </div>

                    <div class="card border-0 bg-light">
                        <div class="card-body">
                            <h6 class="text-secondary fw-bold mb-3"><i class="fas fa-eye me-1"></i> Email Preview</h6>
                            <div class="p-3 border rounded bg-white">
                                <p><strong>Subject:</strong> Assistance Request: Pack Order <span id="previewOrderNumber" class="text-primary fw-bold"></span></p>
                                <hr />
                                <p>Hello [Target RDC] Team,</p>
                                <p>We are requesting your assistance to pack an order due to local stock shortages.</p>
                                <div class="bg-light p-2 rounded mb-3">
                                    <strong>Items needed:</strong>
                                    <ul id="previewItemsList" class="mt-2 text-muted"></ul>
                                </div>
                                <div class="text-center mt-3">
                                    <button type="button" class="btn btn-success disabled" style="opacity:1"><i class="fas fa-check"></i> Accept Packing Request</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary px-4" id="sendBtn" onclick="sendRequest()">
                    <i class="fas fa-paper-plane me-2"></i> Send Email Request
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const requestModal = new bootstrap.Modal(document.getElementById('requestModal'));

        function openRequestModal(orderId, orderNumber, items) {
            document.getElementById('selectedOrderId').value = orderId;
            document.getElementById('previewOrderNumber').innerText = orderNumber;
            document.getElementById('targetRdc').value = '';
            
            const ul = document.getElementById('previewItemsList');
            ul.innerHTML = '';
            items.forEach(item => {
                const li = document.createElement('li');
                li.innerText = `${item.quantity} x ${item.productName}`;
                ul.appendChild(li);
            });
            
            requestModal.show();
        }

        async function sendRequest() {
            var targetRdc = document.getElementById('targetRdc').value;
            if(!targetRdc) {
                alert("Please select a Target RDC");
                return;
            }

            var orderId = document.getElementById('selectedOrderId').value;

            // UI feedback
            var btn = document.getElementById('sendBtn');
            var originalText = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Sending...';
            btn.disabled = true;

            const url = '@Url.Action("SendRequest", "RdcAssistance")';
            const formData = new FormData();
            formData.append('orderId', orderId);
            formData.append('targetRdcId', targetRdc);

            try {
                const response = await fetch(url, {
                    method: 'POST',
                    body: formData
                });
                
                const result = await response.json();
                if(result.success) {
                    alert('Success: ' + result.message);
                    location.reload();
                } else {
                    alert('Error: ' + result.message);
                }
            } catch(e) {
                alert('An unexpected error occurred.');
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }
    </script>
}