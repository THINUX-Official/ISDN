@model IEnumerable<ISDN.Models.CartItemViewModel>
@using System.Linq

@{
    Layout = "_Layout";
    ViewData["Title"] = "Secure Payment";

    var items = Model ?? Enumerable.Empty<ISDN.Models.CartItemViewModel>();
    var totalSum = items.Sum(i => i.Total);
}

<style>
    body {
        background-color: #f4f7f9;
    }

    .checkout-container {
        max-width: 1100px;
        margin: auto;
    }

    .glass-card {
        border-radius: 20px;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(26, 35, 126, 0.08);
        border: none;
        overflow: hidden;
    }

    .section-title {
        color: #1a237e;
        font-weight: 800;
        letter-spacing: 1px;
        border-bottom: 3px solid #1a237e;
        display: inline-block;
        padding-bottom: 5px;
    }

    .form-control {
        border-radius: 10px;
        border: 1.5px solid #e0e6ed;
        padding: 12px;
        transition: 0.3s;
    }

        .form-control:focus {
            border-color: #1a237e;
            box-shadow: 0 0 0 0.2rem rgba(26, 35, 126, 0.1);
        }

    .method-card {
        border: 2px solid #edf2f7;
        padding: 18px;
        border-radius: 15px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        margin-bottom: 12px;
        background: #fff;
    }

        .method-card:hover {
            border-color: #1a237e;
            background: #f0f3ff;
            transform: translateY(-2px);
        }

    .payment-box {
        border-radius: 15px;
        padding: 25px;
        margin-top: 20px;
        animation: fadeIn 0.5s;
    }

    #cardSection {
        background: linear-gradient(135deg, #f8faff 0%, #eff4ff 100%);
        border: 1px solid #d1d9ff;
    }

    #bankSection {
        background: linear-gradient(135deg, #f0fff4 0%, #e6fffa 100%);
        border: 1px solid #38a169;
    }

    .total-row {
        color: #d32f2f;
        font-size: 1.8rem;
    }

    .btn-place-order {
        background: linear-gradient(45deg, #d32f2f, #f44336);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 18px;
        font-size: 1.1rem;
        transition: 0.4s;
        width: 100%;
        cursor: pointer;
    }

        .btn-place-order:hover {
            transform: scale(1.02);
            opacity: 0.9;
        }

    .error-display {
        color: #fff;
        background: #ef5350;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 20px;
        display: none;
        box-shadow: 0 4px 12px rgba(239, 83, 80, 0.3);
        font-weight: bold;
        border-left: 5px solid #b71c1c;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="container checkout-container mt-5 mb-5">
    <div id="error-msg" class="error-display" style="@(TempData["ErrorMessage"] != null ? "display:block;" : "display:none;")">@TempData["ErrorMessage"]</div>

    <form asp-controller="Customer" asp-action="ProcessPayment" method="post" id="checkoutForm" onsubmit="return validateForm()">
        @Html.AntiForgeryToken()

        <input type="hidden" name="amount" value="@totalSum" />

        <div class="row">
            <div class="col-lg-7">
                <div class="glass-card p-4 mb-4">

                    @* Branch selection for PBOS/PBOM *@
                    @{
                        var userType = ViewBag.UserType as string ?? string.Empty;
                    }

                    @if (!string.IsNullOrEmpty(userType) && (userType.Equals("PBOS", StringComparison.OrdinalIgnoreCase) || userType.Equals("PBOM", StringComparison.OrdinalIgnoreCase)))
                    {
                        <h5 class="section-title mb-3">Order Destination</h5>
                        <div class="mb-3">
                            @if (userType.Equals("PBOM", StringComparison.OrdinalIgnoreCase))
                            {
                                <label class="small font-weight-bold">Business Type</label>
                                <select id="businessTypeSelect" name="businessType" class="form-control mb-2">
                                    <option value="">-- Select Business Type --</option>
                                    @if (ViewBag.BusinessTypes != null)
                                    {
                                        foreach(var t in (IEnumerable<string>)ViewBag.BusinessTypes)
                                        {
                                            <option value="@t">@t</option>
                                        }
                                    }
                                </select>
                            }

                            <label class="small font-weight-bold">Select Branch</label>
                            <select id="branchSelect" name="selectedBranchId" class="form-control">
                                <option value="">-- Select Branch --</option>
                                @if (ViewBag.ClusterBranches != null)
                                {
                                    foreach(var b in (IEnumerable<dynamic>)ViewBag.ClusterBranches)
                                    {
                                        <option value="@b.CustomerId">@b.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    }

                    <h4 class="section-title mb-4">BILLING DETAILS</h4>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="small font-weight-bold text-muted text-uppercase">First Name</label>
                            <input type="text" name="firstName" class="form-control" value="@ViewBag.FirstName" readonly />
                        </div>
                        <div class="col-6">
                            <label class="small font-weight-bold text-muted text-uppercase">Last Name</label>
                            <input type="text" name="lastName" class="form-control" value="@ViewBag.LastName" readonly />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="small font-weight-bold text-muted text-uppercase">Street Address</label>
                        <input type="text" name="address" class="form-control" value="@ViewBag.Address" readonly />
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="small font-weight-bold text-muted text-uppercase">ZIP Code</label>
                            <input type="text" name="zipCode" class="form-control" value="@ViewBag.ZipCode" readonly />
                        </div>
                        <div class="col-6">
                            <label class="small font-weight-bold text-muted text-uppercase">Phone</label>
                            <input type="text" name="phoneNumber" class="form-control" value="@ViewBag.PhoneNumber" readonly />
                        </div>
                    </div>

                    <h4 class="section-title mb-4 mt-4">PAYMENT METHOD</h4>
                    <div class="payment-methods">
                        <div class="method-card" onclick="toggleSection('card')">
                            <input type="radio" name="payment_method" value="Card" id="payCard" checked>
                            <label for="payCard" class="ml-3 mb-0 font-weight-bold" style="margin-left:10px;">Credit / Debit Card</label>
                        </div>
                        <div class="method-card" onclick="toggleSection('bank')">
                            <input type="radio" name="payment_method" value="Bank Transfer" id="payBank">
                            <label for="payBank" class="ml-3 mb-0 font-weight-bold" style="margin-left:10px;">Direct Bank Transfer</label>
                        </div>
                    </div>

                    <div id="cardSection" class="payment-box">
                        <h5 class="text-primary mb-4 font-weight-bold"><i class="fas fa-credit-card mr-2"></i> CARD INFORMATION</h5>
                        <div class="mb-3">
                            <label class="small font-weight-bold">BANK NAME</label>
                            <input type="text" id="bank_name" name="card_name" class="form-control" placeholder="E.g. BOC, Sampath" />
                        </div>
                        <div class="mb-3">
                            <label class="small font-weight-bold">CARD NUMBER</label>
                            <input type="text" id="card_num" name="card_number" class="form-control" maxlength="16" placeholder="1234 5678 9101 1121" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                        </div>
                        <div class="row">
                            <div class="col-4">
                                <label class="small font-weight-bold">EXP MONTH</label>
                                <input type="number" id="exp_month" name="exp_month" class="form-control" placeholder="MM" min="1" max="12" />
                            </div>
                            <div class="col-4">
                                <label class="small font-weight-bold">EXP YEAR</label>
                                <input type="text" id="exp_year" name="exp_year" class="form-control" placeholder="YY" maxlength="2" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                            </div>
                            <div class="col-4">
                                <label class="small font-weight-bold">CVC</label>
                                <input type="text" id="cvc" name="cvc" class="form-control" placeholder="123" maxlength="3" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                            </div>
                        </div>
                    </div>

                    <div id="bankSection" class="payment-box" style="display:none;">
                        <h5 class="text-success mb-3 font-weight-bold">OUR BANK DETAILS</h5>
                        <div class="p-3 bg-white rounded border-left border-success" style="border-left: 5px solid #28a745 !important;">
                            <p class="mb-1"><strong>Bank:</strong> Bank of Ceylon (BOC)</p>
                            <p class="mb-0"><strong>Account Number:</strong> 8899001122</p>
                        </div>
                        <div class="mt-4">
                            <label class="small font-weight-bold">TRANSACTION ID / SLIP REFERENCE *</label>
                            <input type="text" name="bank_ref" id="bank_ref" class="form-control border-success">
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="glass-card p-4">
                    <h4 class="text-center text-primary font-weight-bold mb-4">ORDER SUMMARY</h4>

                    <div style="max-height: 300px; overflow-y: auto;">
                        @foreach (var item in items)
                        {
                            <div class="d-flex justify-content-between py-2 border-bottom small">
                                <span>@item.ProductName (x@item.Quantity)</span>
                                <span class="font-weight-bold">Rs. @item.Total.ToString("N2")</span>
                            </div>
                        }
                    </div>

                    <div class="py-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="font-weight-bold h5">Grand Total</span>
                            <span class="total-row font-weight-bold">Rs. @totalSum.ToString("N2")</span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-place-order shadow-lg text-uppercase font-weight-bold">
                        Complete My Order <i class="fas fa-arrow-right ml-2"></i>
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    function toggleSection(method) {
        document.getElementById('error-msg').style.display = 'none';
        if (method === 'card') {
            document.getElementById('cardSection').style.display = 'block';
            document.getElementById('bankSection').style.display = 'none';
            document.getElementById('payCard').checked = true;
        } else {
            document.getElementById('cardSection').style.display = 'none';
            document.getElementById('bankSection').style.display = 'block';
            document.getElementById('payBank').checked = true;
        }
    }

    function validateForm() {
        var errorDisplay = document.getElementById('error-msg');
        errorDisplay.style.display = 'none';

        var method = document.querySelector('input[name="payment_method"]:checked').value;

        if (method === 'Card') {
            var bankName = document.getElementById('bank_name').value.trim();
            var cardNum = document.getElementById('card_num').value.trim();
            var month = document.getElementById('exp_month').value.trim();
            var year = document.getElementById('exp_year').value.trim();
            var cvc = document.getElementById('cvc').value.trim();

            // 1. Check if empty
            if (!bankName || !cardNum || !month || !year || !cvc) {
                showError("⚠️ Please fill in all card details (Bank Name, Number, Expiry, and CVC).");
                return false;
            }

            // 2. Card Number Length (16 digits)
            if (cardNum.length !== 16) {
                showError("⚠️ Card Number must be exactly 16 digits.");
                return false;
            }

            // 3. Month Validation
            var m = parseInt(month);
            if (m < 1 || m > 12) {
                showError("⚠️ Invalid Expiry Month (1-12).");
                return false;
            }

            // 4. CVC Length (3 digits)
            if (cvc.length !== 3) {
                showError("⚠️ CVC must be exactly 3 digits.");
                return false;
            }

        } else {
            // Bank Transfer Validation
            var bankRef = document.getElementById('bank_ref').value.trim();
            if (!bankRef) {
                showError("⚠️ Please enter the Transaction ID / Slip Reference for Bank Transfer.");
                return false;
            }
        }

        return true; // Everything is OK, submit the form
    }

    function showError(msg) {
        var errorDisplay = document.getElementById('error-msg');
        errorDisplay.innerHTML = msg;
        errorDisplay.style.display = 'block';
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }
</script>