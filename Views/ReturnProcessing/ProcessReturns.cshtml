@model IEnumerable<ISDN.ViewModels.ReturnProcessingViewModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Return Processing";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">Return Requests</h3>
        <div>
            <a href="?status=PENDING" onclick="location.replace('?status=PENDING'); return false;" class="btn btn-outline-primary me-2">Pending</a>
            <a href="?status=APPROVED" onclick="location.replace('?status=APPROVED'); return false;" class="btn btn-outline-success me-2">Approved</a>
            <a href="?status=ALL" onclick="location.replace('?status=ALL'); return false;" class="btn btn-outline-secondary">All</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ReturnID</th>
                        <th>Order Number</th>
                        <th>Order ID</th>
                        <th>Product</th>
                        <th>Qty</th>
                        <th>Subtotal</th>
                        <th>Admin Comment</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var r in Model)
                    {
                        <tr>
                            <td>@r.ReturnId</td>
                            <td>@r.OrderNumber</td>
                            <td>@r.OrderId</td>
                            <td>@r.ProductName</td>
                            <td>@r.Quantity</td>
                            <td>Rs. @r.Subtotal.ToString("N2")</td>
                            <td>@r.AdminComment</td>
                            <td>
                                @if (r.AdminStatus == "APPROVED" && r.RefundStatus != "COMPLETED")
                                {
                                    <button class="btn btn-sm btn-primary" data-returnid="@r.ReturnId" onclick="openProcessModal(@r.ReturnId)">Process Refund</button>
                                }
                                else if (r.RefundStatus == "COMPLETED")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- PayPal Billing Modal -->
<div class="modal fade" id="billingModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">Process Refund (PayPal Sandbox)</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p>Total refund amount: <strong id="refundTotal">Rs. 0.00</strong></p>
        <div id="paypal-button-container"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
      </div>
    </div>
  </div>
</div>

<!-- Email Modal (reuse existing send invoice modal if present) -->
@await Html.PartialAsync("~/Views/Shared/_SendInvoiceModal.cshtml")

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://www.paypal.com/sdk/js?client-id=@ViewBag.PaypalClientId&currency=USD"></script>
<script>
    var currentReturnId = 0;
    var currentRefundAmount = 0;

    function openProcessModal(returnId){
        currentReturnId = returnId;
        // fetch details
        fetch('/ReturnProcessing/GetReturnDetails?returnId=' + returnId)
            .then(r => r.json()).then(data => {
                currentRefundAmount = parseFloat(data.totalRefundAmount || data.subtotal || 0);
                document.getElementById('refundTotal').innerText = 'Rs. ' + currentRefundAmount.toFixed(2);
                // render paypal button
                renderPayPalButton();
                var bm = new bootstrap.Modal(document.getElementById('billingModal'));
                bm.show();
            }).catch(err => alert('Failed to load return details'));
    }

    function renderPayPalButton(){
        // Clear container
        var container = document.getElementById('paypal-button-container');
        container.innerHTML = '';

        paypal.Buttons({
            createOrder: function(data, actions){
                return actions.order.create({
                    purchase_units: [{
                        amount: { value: currentRefundAmount.toFixed(2) }
                    }]
                });
            },
            onApprove: function(data, actions){
                return actions.order.capture().then(function(details){
                    // call server to process return (update inventory)
                    fetch('/ReturnProcessing/ProcessReturn', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: JSON.stringify({ returnId: currentReturnId })
                    }).then(r => r.json()).then(j => {
                        if(j.success){
                            var bm = bootstrap.Modal.getInstance(document.getElementById('billingModal'));
                            bm.hide();
                            // open email modal
                            var em = new bootstrap.Modal(document.getElementById('sendInvoiceModal'));
                            fetch('/ReturnProcessing/GetReturnDetails?returnId=' + currentReturnId)
                                .then(r => r.json()).then(d => {
                                    document.getElementById('si_recipient').value = d.customer?.email || '';
                                    document.getElementById('si_subject').value = 'Refund Processed - Order #' + d.orderId;
                                    document.getElementById('si_message').value = 'Your refund of Rs. ' + currentRefundAmount.toFixed(2) + ' has been processed.';
                                    em.show();
                                });
                        } else {
                            alert(j.message || 'Failed to process return');
                        }
                    }).catch(err => alert('Server error'));
                });
            },
            onError: function(err){
                alert('Payment gateway error: ' + err);
            }
        }).render('#paypal-button-container');
    }
</script>
