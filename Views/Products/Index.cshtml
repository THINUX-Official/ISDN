@model IEnumerable<ISDN.Models.Product>
@* ✅ CHANGED from ISDN_Distribution.Models.Product *@

@{
    ViewData["Title"] = "Products";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="fas fa-shopping-bag"></i> Our Products</h2>
            <p class="text-muted">Browse our product catalog</p>
        </div>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var product in Model)
            {
                <div class="col-md-4 col-lg-3 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(product.ProductImageUrl))
                        {
                            <img src="@product.ProductImageUrl" class="card-img-top" alt="@product.ProductName" 
                                 style="height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center" 
                                 style="height: 200px;">
                                <i class="fas fa-image fa-3x"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@product.ProductName</h5>
                            @if (!string.IsNullOrEmpty(product.Category))
                            {
                                <span class="badge bg-primary mb-2 align-self-start">@product.Category</span>
                            }
                            <p class="card-text text-muted small">
                                @(product.Description?.Length > 80 ? product.Description.Substring(0, 80) + "..." : product.Description ?? "No description")
                            </p>
                            <div class="mt-auto">
                                <h4 class="text-success">LKR @product.UnitPrice.ToString("N2")</h4>
                                <a asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-primary w-100">
                                    <i class="fas fa-info-circle"></i> View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="fas fa-inbox fa-5x text-muted mb-3"></i>
                <h3 class="text-muted">No products available</h3>
                <p class="text-muted">Check back later for new products</p>
            </div>
        }
    </div>
</div>  