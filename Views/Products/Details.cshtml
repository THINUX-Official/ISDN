@model ISDN.Models.Product
@* ✅ CHANGED from ISDN_Distribution.Models.Product *@

@{
    ViewData["Title"] = "Product Details";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0"><i class="fas fa-info-circle"></i> Product Details</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 text-center">
                            @if (!string.IsNullOrEmpty(Model.ProductImageUrl))
                            {
                                <img src="@Model.ProductImageUrl" alt="@Model.ProductName" 
                                     class="img-fluid rounded shadow" />
                            }
                            else
                            {
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded" 
                                     style="height: 300px;">
                                    <i class="fas fa-image fa-5x"></i>
                                </div>
                            }
                        </div>
                        <div class="col-md-8">
                            <h2>@Model.ProductName</h2>
                            
                            <div class="mb-3">
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success fs-6"><i class="fas fa-check-circle"></i> Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary fs-6"><i class="fas fa-times-circle"></i> Inactive</span>
                                }
                            </div>

                            <hr />

                            <dl class="row">
                                <dt class="col-sm-4">SKU</dt>
                                <dd class="col-sm-8">@(Model.Sku ?? "N/A")</dd>

                                <dt class="col-sm-4">Category</dt>
                                <dd class="col-sm-8">
                                    @if (!string.IsNullOrEmpty(Model.Category))
                                    {
                                        <span class="badge bg-primary">@Model.Category</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Unit Price</dt>
                                <dd class="col-sm-8">
                                    <strong class="text-success fs-4">LKR @Model.UnitPrice.ToString("N2")</strong>
                                </dd>

                                <dt class="col-sm-4">Description</dt>
                                <dd class="col-sm-8">@(Model.Description ?? "No description available")</dd>

                                <dt class="col-sm-4">Created Date</dt>
                                <dd class="col-sm-8">@Model.CreatedAt.ToString("MMMM dd, yyyy")</dd>
                            </dl>

                            @if (User.IsInRole("ADMIN"))
                            {
                                <hr />
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-warning">
                                        <i class="fas fa-edit"></i> Edit Product
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@Model.ProductId" class="btn btn-danger">
                                        <i class="fas fa-trash"></i> Delete Product
                                    </a>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to Products
                        </a>
                        @if (User.IsInRole("ADMIN"))
                        {
                            <a asp-action="Manage" class="btn btn-primary">
                                <i class="fas fa-cog"></i> Manage Products
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>