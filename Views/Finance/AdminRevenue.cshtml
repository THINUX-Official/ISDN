@model ISDN.ViewModels.AdminRevenueViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Finance Dashboard";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="dashboard-title text-uppercase mb-1">Finance Dashboard</h2>
            <p class="text-muted small"><i class="fas fa-map-marker-alt mr-1"></i> Regional Distribution Center: <strong>@Model.RdcName</strong></p>
        </div>
        <button class="btn btn-outline-primary btn-sm rounded-pill px-4 no-print" onclick="window.print()"><i class="fas fa-download mr-2"></i> Export Report PDF</button>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card revenue-card text-white p-3" style="background: linear-gradient(135deg, #1a237e 0%, #5c6bc0 100%);">
                <div class="card-body">
                    <div class="icon-box"><i class="fas fa-wallet"></i></div>
                    <div class="stat-label">Total Net Revenue</div>
                    <div class="stat-value mt-2">Rs. @Model.NetRevenue.ToString("N2")</div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card revenue-card text-white p-3" style="background: linear-gradient(135deg, #00695c 0%, #26a69a 100%);">
                <div class="card-body">
                    <div class="icon-box"><i class="fas fa-shopping-cart"></i></div>
                    <div class="stat-label">Completed Orders</div>
                    <div class="stat-value mt-2">@Model.CompletedOrders</div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card revenue-card text-white p-3" style="background: linear-gradient(135deg, #c62828 0%, #ef5350 100%);">
                <div class="card-body">
                    <div class="icon-box"><i class="fas fa-undo"></i></div>
                    <div class="stat-label">Return Deductions</div>
                    <div class="stat-value mt-2">Rs. @Model.TotalReturns.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-12">
            <div class="chart-box">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="font-weight-bold" style="color: #1a237e;">Revenue Analytics - Performance Metrics</h5>
                    <div class="small text-muted font-weight-bold">Live System Sync</div>
                </div>

                <div style="height: 380px; position: relative;">
                    <canvas id="revenueBarChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card p-3">
                <h6 class="mb-2">Customer Count</h6>
                <div class="h3">@Model.CustomerCount</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card p-3">
                <h6 class="mb-2">Total Sales (Gross)</h6>
                <div class="h3">Rs. @Model.TotalSales.ToString("N2")</div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    (function(){
        var ctx = document.getElementById('revenueBarChart').getContext('2d');
        var dataVal = @Model.NetRevenue;
        var label = "@Model.RdcName";

        var gradient = ctx.createLinearGradient(0,0,0,400);
        gradient.addColorStop(0, 'rgba(26,35,126,1)');
        gradient.addColorStop(1, 'rgba(92,107,192,0.6)');

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: [label],
                datasets: [{
                    label: 'Net Revenue (LKR)',
                    data: [dataVal],
                    backgroundColor: gradient,
                    borderColor: '#1a237e',
                    borderWidth: 2,
                    borderRadius: 12,
                    barThickness: 120
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true, ticks: { callback: function(v){ return 'Rs.'+v.toLocaleString(); } } }
                },
                plugins: { legend: { display: false } }
            }
        });
    })();
</script>
