@model ISDN.Models.DashboardViewModel
@{
    ViewData["Title"] = "Management Dashboard";
    string BadgeClass(string? status) => (status ?? "").ToUpper().Trim() switch {
        "DELIVERED" => "delivered",
        "COMPLETED" => "completed",
        "PENDING"   => "pending",
        "CANCELLED" => "cancelled",
        _           => "completed"
    };
}

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Management Dashboard</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root{
      --navy:#03045E;
      --blue:#0077B6;
      --cyan:#00B4D8;
      --sky:#90E0EF;
      --ice:#CAF0F8;
      --text:#06102b;
      --muted:#4b5563;
      --card:#ffffff;
      --radius:16px;
      --shadow: 0 12px 30px rgba(3,4,94,.10);
      --shadow-soft: 0 8px 22px rgba(3,4,94,.08);
      --border: rgba(3,4,94,.10);
    }

    *{ box-sizing:border-box; }
    body{
      margin:0;
      font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      color:var(--text);
      background: linear-gradient(180deg, var(--ice) 0%, #fff 35%, rgba(144,224,239,.35) 100%);
      min-height: 100vh;
    }

    .wrap{
      max-width: 1200px;
      margin: 0 auto;
      padding: 28px 16px 60px;
    }

    /* Header */
    .page-head{
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap:16px;
      padding: 22px 22px;
      border-radius: var(--radius);
      background: linear-gradient(135deg, rgba(0,180,216,.18), rgba(0,119,182,.10));
      border: 1px solid var(--border);
      box-shadow: var(--shadow-soft);
      margin-bottom: 20px;
    }
    .title{ display:flex; align-items:center; gap:12px; }
    .logo-dot{
      width:44px; height:44px; border-radius:12px;
      background: radial-gradient(circle at 30% 30%, var(--cyan), var(--navy));
      box-shadow: 0 10px 18px rgba(3,4,94,.18);
      flex-shrink:0;
    }
    h1{
      margin:0;
      font-size: 22px;
      line-height: 1.2;
      letter-spacing:-0.02em;
      color: var(--navy);
    }
    .sub{ margin-top:5px; font-size:13px; color:var(--muted); }

    /* Buttons */
    .btn{
      height:42px;
      border-radius:12px;
      padding:0 16px;
      border:1px solid transparent;
      font-weight:600;
      font-family:inherit;
      font-size:13px;
      cursor:pointer;
      display:inline-flex;
      align-items:center;
      gap:8px;
      transition:.15s ease;
      text-decoration:none;
      user-select:none;
    }
    .btn-primary{
      background:var(--navy);
      color:#fff;
      box-shadow:0 10px 18px rgba(3,4,94,.16);
    }
    .btn-primary:hover{ background:#0507a0; transform:translateY(-1px); }
    .btn-outline{
      background:#fff;
      color:var(--navy);
      border-color:rgba(3,4,94,.22);
    }
    .btn-outline:hover{
      border-color:rgba(0,119,182,.6);
      box-shadow:0 10px 18px rgba(0,119,182,.10);
      transform:translateY(-1px);
    }

    /* Card base */
    .card{
      background:var(--card);
      border:1px solid var(--border);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
    }

    /* KPI cards */
    .kpis{
      display:grid;
      grid-template-columns:repeat(3, minmax(0,1fr));
      gap:14px;
      margin-bottom:20px;
    }
    .kpi{
      padding:16px 18px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      background:linear-gradient(180deg,rgba(202,240,248,.55),#fff);
    }
    .kpi .klabel{
      font-size:11px;
      font-weight:700;
      color:var(--blue);
      text-transform:uppercase;
      letter-spacing:.07em;
    }
    .kpi .kvalue{
      margin-top:6px;
      font-size:20px;
      font-weight:800;
      color:var(--navy);
      font-variant-numeric:tabular-nums;
    }
    .kpi .khint{
      font-size:11px;
      color:var(--muted);
      margin-top:3px;
    }
    .kpi-icon{
      width:46px; height:46px; border-radius:14px;
      display:grid; place-items:center;
      font-size:20px;
      flex-shrink:0;
    }

    /* Two-column grid */
    .two-col{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:16px;
      margin-bottom:16px;
    }

    /* Section card */
    .section-card{ overflow:hidden; }
    .section-head{
      padding:12px 16px;
      border-bottom:1px solid var(--border);
      background:rgba(144,224,239,.28);
      display:flex;
      align-items:center;
      justify-content:space-between;
    }
    .section-head h2{
      margin:0;
      font-size:13px;
      font-weight:700;
      color:var(--navy);
      letter-spacing:.01em;
    }
    .section-head .badge-count{
      font-size:11px;
      color:var(--muted);
    }

    /* Tables */
    .table-wrap{ overflow:auto; }
    table{
      width:100%;
      border-collapse:separate;
      border-spacing:0;
    }
    thead th{
      background:rgba(144,224,239,.40);
      color:var(--navy);
      font-size:11px;
      text-transform:uppercase;
      letter-spacing:.06em;
      padding:10px 14px;
      border-bottom:1px solid var(--border);
      text-align:left;
      white-space:nowrap;
      font-family:inherit;
    }
    tbody td{
      padding:10px 14px;
      border-bottom:1px solid rgba(3,4,94,.07);
      font-size:13px;
      white-space:nowrap;
    }
    tbody tr:nth-child(odd){ background:rgba(202,240,248,.18); }
    tbody tr:hover{ background:rgba(0,180,216,.09); }
    .num{ text-align:right; font-variant-numeric:tabular-nums; }
    .mono{ font-variant-numeric:tabular-nums; }

    /* Status badges */
    .badge{
      display:inline-flex;
      align-items:center;
      gap:6px;
      padding:4px 10px;
      border-radius:999px;
      font-size:11px;
      font-weight:700;
      border:1px solid transparent;
    }
    .dot{
      width:7px; height:7px; border-radius:999px;
      background:currentColor; opacity:.9; flex-shrink:0;
    }
    .delivered{ color:var(--blue); background:rgba(0,119,182,.12); border-color:rgba(0,119,182,.25); }
    .completed{ color:var(--navy); background:rgba(144,224,239,.35); border-color:rgba(3,4,94,.18); }
    .pending{ color:#055f73; background:rgba(0,180,216,.14); border-color:rgba(0,180,216,.28); }
    .cancelled{ color:var(--navy); background:rgba(3,4,94,.08); border-color:rgba(3,4,94,.18); }

    /* Low stock qty highlight */
    .qty-warn{ color:#b45309; font-weight:700; }

    /* Empty state */
    .empty{ text-align:center; padding:28px 16px; color:var(--muted); font-size:13px; }

    /* Responsive */
    @@media(max-width:900px){
      .page-head{ flex-direction:column; align-items:flex-start; }
      .kpis{ grid-template-columns:1fr; }
      .two-col{ grid-template-columns:1fr; }
    }
  </style>
</head>

<body>
<div class="wrap">

  <!-- HEADER -->
  <div class="page-head">
    <div>
      <div class="title">
        <div class="logo-dot"></div>
        <div>
          <h1>Management Dashboard</h1>
          <div class="sub">
            Welcome, <strong>@Model.UserName</strong>
            &nbsp;·&nbsp; Role: @Model.UserRole
          </div>
        </div>
      </div>
    </div>
    <div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end;">
      <a class="btn btn-primary" asp-controller="ManageDashboard" asp-action="SalesReport">📊 Open Sales Report</a>
      <a class="btn btn-primary" asp-controller="ManageDashboard" asp-action="InventoryReport">📦 Inventory Report</a>
      <a class="btn btn-primary" asp-controller="ManageDashboard" asp-action="PendingOrdersReport">⏳ Pending Orders Report</a>
    </div>
  </div>

  <!-- KPI CARDS -->
  <div class="kpis">
    <div class="card kpi">
      <div>
        <div class="klabel">Sales Today</div>
        <div class="kvalue">LKR @Model.SalesToday.ToString("N2")</div>
        <div class="khint">Delivered &amp; completed</div>
      </div>
      <div class="kpi-icon" style="background:rgba(0,119,182,.12);border:1px solid rgba(0,119,182,.22);">💰</div>
    </div>

    <div class="card kpi">
      <div>
        <div class="klabel">Sales This Month</div>
        <div class="kvalue">LKR @Model.SalesMonth.ToString("N2")</div>
        <div class="khint">Delivered &amp; completed</div>
      </div>
      <div class="kpi-icon" style="background:rgba(0,180,216,.14);border:1px solid rgba(0,180,216,.22);">📈</div>
    </div>

    <div class="card kpi">
      <div>
        <div class="klabel">Pending Orders</div>
        <div class="kvalue">@Model.PendingOrdersCount</div>
        <div class="khint">Awaiting processing</div>
      </div>
      <div class="kpi-icon" style="background:rgba(144,224,239,.35);border:1px solid rgba(3,4,94,.15);">📦</div>
    </div>
  </div>

  <!-- ROW 1: Orders by Status | Top Products -->
  <div class="two-col">

    <div class="card section-card">
      <div class="section-head">
        <h2>Orders by Status</h2>
        <span class="badge-count">Last 30 days</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Status</th><th class="num">Count</th></tr>
          </thead>
          <tbody>
            @if (!Model.OrdersByStatus.Any())
            {
              <tr><td colspan="2" class="empty">No data available.</td></tr>
            }
            else
            {
              foreach (var row in Model.OrdersByStatus)
              {
                <tr>
                  <td>
                    <span class="badge @BadgeClass(row.Status)">
                      <span class="dot"></span>@(row.Status?.ToUpper())
                    </span>
                  </td>
                  <td class="num mono">@row.Count</td>
                </tr>
              }
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="card section-card">
      <div class="section-head">
        <h2>Top 5 Products</h2>
        <span class="badge-count">Last 30 days</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Product</th><th class="num">Sold Qty</th></tr>
          </thead>
          <tbody>
            @if (!Model.TopProducts.Any())
            {
              <tr><td colspan="2" class="empty">No data available.</td></tr>
            }
            else
            {
              foreach (var p in Model.TopProducts)
              {
                <tr>
                  <td>@p.ProductName</td>
                  <td class="num mono">@p.TotalQuantity</td>
                </tr>
              }
            }
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- ROW 2: Low Stock | Recent Orders -->
  <div class="two-col">

    <div class="card section-card">
      <div class="section-head">
        <h2>⚠️ Low Stock Items</h2>
        <span class="badge-count">At or below reorder level</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Product</th><th class="num">Qty</th><th class="num">Reorder Level</th></tr>
          </thead>
          <tbody>
            @if (!Model.LowStockItems.Any())
            {
              <tr><td colspan="3" class="empty">All stock levels are healthy.</td></tr>
            }
            else
            {
              foreach (var l in Model.LowStockItems)
              {
                <tr>
                  <td>@l.ProductName</td>
                  <td class="num mono qty-warn">@l.QtyOnHand</td>
                  <td class="num mono">@l.ReorderLevel</td>
                </tr>
              }
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="card section-card">
      <div class="section-head">
        <h2>Recent Orders</h2>
        <span class="badge-count">Latest 10</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Order ID</th><th>Date</th><th>Status</th><th class="num">Total</th></tr>
          </thead>
          <tbody>
            @if (!Model.RecentOrders.Any())
            {
              <tr><td colspan="4" class="empty">No recent orders found.</td></tr>
            }
            else
            {
              foreach (var o in Model.RecentOrders)
              {
                <tr>
                  <td class="mono">#@o.OrderId</td>
                  <td class="mono">@o.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                  <td>
                    <span class="badge @BadgeClass(o.Status)">
                      <span class="dot"></span>@(o.Status?.ToUpper())
                    </span>
                  </td>
                  <td class="num mono">LKR @o.TotalAmount.ToString("N2")</td>
                </tr>
              }
            }
          </tbody>
        </table>
      </div>
    </div>

  </div>

</div>
</body>
</html>
