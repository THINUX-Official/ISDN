@model ISDN.Models.InventoryReportViewModel
@{
    ViewData["Title"] = "Inventory Report";
}

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Inventory Report</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root{
      --navy:#03045E; --blue:#0077B6; --cyan:#00B4D8;
      --sky:#90E0EF; --ice:#CAF0F8; --text:#06102b;
      --muted:#4b5563; --card:#ffffff; --radius:16px;
      --shadow:0 12px 30px rgba(3,4,94,.10);
      --shadow-soft:0 8px 22px rgba(3,4,94,.08);
      --border:rgba(3,4,94,.10);
    }
    *{ box-sizing:border-box; }
    body{
      margin:0;
      font-family:Inter,system-ui,-apple-system,sans-serif;
      color:var(--text);
      background:linear-gradient(180deg,var(--ice) 0%,#fff 35%,rgba(144,224,239,.35) 100%);
      min-height:100vh;
    }
    .wrap{ max-width:1120px; margin:0 auto; padding:28px 16px 60px; }

    .page-head{
      display:flex; align-items:flex-end; justify-content:space-between;
      gap:16px; padding:22px; border-radius:var(--radius);
      background:linear-gradient(135deg,rgba(0,180,216,.18),rgba(0,119,182,.10));
      border:1px solid var(--border); box-shadow:var(--shadow-soft); margin-bottom:18px;
    }
    .title{ display:flex; align-items:center; gap:12px; }
    .logo-dot{
      width:40px; height:40px; border-radius:12px;
      background:radial-gradient(circle at 30% 30%,var(--cyan),var(--navy));
      box-shadow:0 10px 18px rgba(3,4,94,.18); flex-shrink:0;
    }
    h1{ margin:0; font-size:24px; line-height:1.2; letter-spacing:-0.02em; color:var(--navy); }
    .sub{ margin-top:6px; font-size:13px; color:var(--muted); }
    .head-actions{ display:flex; gap:10px; flex-wrap:wrap; justify-content:flex-end; }

    .btn{
      height:42px; border-radius:12px; padding:0 14px;
      border:1px solid transparent; font-weight:600; font-family:inherit;
      font-size:13px; cursor:pointer; display:inline-flex; align-items:center;
      gap:8px; transition:.15s ease; text-decoration:none; user-select:none;
    }
    .btn-primary{ background:var(--navy); color:#fff; box-shadow:0 10px 18px rgba(3,4,94,.16); }
    .btn-primary:hover{ background:#0507a0; transform:translateY(-1px); }
    .btn-outline{ background:#fff; color:var(--navy); border-color:rgba(3,4,94,.22); }
    .btn-outline:hover{ border-color:rgba(0,119,182,.6); box-shadow:0 10px 18px rgba(0,119,182,.10); transform:translateY(-1px); }

    .card{ background:var(--card); border:1px solid var(--border); border-radius:var(--radius); box-shadow:var(--shadow); }

    .kpis{ display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin:0 0 14px; }
    .kpi{
      padding:14px 16px; display:flex; align-items:center;
      justify-content:space-between; gap:10px;
      background:linear-gradient(180deg,rgba(202,240,248,.55),#fff);
    }
    .kpi .klabel{ font-size:11px; font-weight:700; color:var(--blue); text-transform:uppercase; letter-spacing:.07em; }
    .kpi .kvalue{ margin-top:6px; font-size:20px; font-weight:800; color:var(--navy); }
    .kpi .khint{ font-size:11px; color:var(--muted); margin-top:3px; }
    .kpi-icon{ width:46px; height:46px; border-radius:14px; display:grid; place-items:center; font-size:20px; flex-shrink:0; }

    .table-card{ overflow:hidden; }
    .table-head{
      padding:14px 16px; border-bottom:1px solid var(--border);
      display:flex; align-items:center; justify-content:space-between;
      gap:12px; background:rgba(144,224,239,.28);
    }
    .table-head h2{ margin:0; font-size:14px; color:var(--navy); }
    .table-wrap{ overflow:auto; }
    table{ width:100%; border-collapse:separate; border-spacing:0; min-width:700px; }
    thead th{
      background:rgba(144,224,239,.45); color:var(--navy); font-size:11px;
      text-transform:uppercase; letter-spacing:.06em; padding:12px 14px;
      border-bottom:1px solid var(--border); text-align:left; white-space:nowrap; font-family:inherit;
    }
    tbody td{ padding:11px 14px; border-bottom:1px solid rgba(3,4,94,.08); font-size:13px; white-space:nowrap; }
    tbody tr:nth-child(odd){ background:rgba(202,240,248,.20); }
    tbody tr:hover{ background:rgba(0,180,216,.10); }
    .num{ text-align:right; font-variant-numeric:tabular-nums; }
    .mono{ font-variant-numeric:tabular-nums; }

    .badge{
      display:inline-flex; align-items:center; gap:5px;
      padding:4px 10px; border-radius:999px; font-size:11px; font-weight:700; border:1px solid transparent;
    }
    .dot{ width:7px; height:7px; border-radius:999px; background:currentColor; opacity:.9; flex-shrink:0; }
    .badge-warn{ color:#92400e; background:rgba(245,158,11,.14); border-color:rgba(245,158,11,.30); }
    .badge-ok  { color:#065f46; background:rgba(16,185,129,.12); border-color:rgba(16,185,129,.25); }
    .qty-warn  { color:#b45309; font-weight:700; }

    .empty{ text-align:center; padding:36px 16px; color:var(--muted); font-size:13px; }

    @@media(max-width:900px){
      .page-head{ flex-direction:column; align-items:flex-start; }
      .kpis{ grid-template-columns:1fr; }
    }
  </style>
</head>
<body>
<div class="wrap">

  <!-- HEADER -->
  <div class="page-head">
    <div>
      <div class="title">
        <div class="logo-dot"></div>
        <div>
          <h1>Inventory Report</h1>
          <div class="sub">Stock levels, reorder alerts, and inventory overview across all products.</div>
        </div>
      </div>
    </div>
    <div class="head-actions">
      <a class="btn btn-outline" asp-controller="ManageDashboard" asp-action="Index">← Back Dashboard</a>
      <a class="btn btn-outline" asp-controller="ManageDashboard" asp-action="ExportInventoryReport">⬇ Export CSV</a>
    </div>
  </div>

  <!-- KPIs -->
  <div class="kpis">
    <div class="card kpi">
      <div>
        <div class="klabel">Total Products</div>
        <div class="kvalue">@Model.TotalItems</div>
        <div class="khint">In inventory</div>
      </div>
      <div class="kpi-icon" style="background:rgba(0,119,182,.12);border:1px solid rgba(0,119,182,.22);">📦</div>
    </div>
    <div class="card kpi">
      <div>
        <div class="klabel">Low Stock Alerts</div>
        <div class="kvalue" style="color:@(Model.LowStockCount > 0 ? "#b45309" : "var(--navy)")">@Model.LowStockCount</div>
        <div class="khint">At or below reorder level</div>
      </div>
      <div class="kpi-icon" style="background:rgba(245,158,11,.14);border:1px solid rgba(245,158,11,.25);">⚠️</div>
    </div>
    <div class="card kpi">
      <div>
        <div class="klabel">Total Qty Available</div>
        <div class="kvalue">@Model.TotalQtyAvailable.ToString("N0")</div>
        <div class="khint">Across all products</div>
      </div>
      <div class="kpi-icon" style="background:rgba(16,185,129,.12);border:1px solid rgba(16,185,129,.22);">✅</div>
    </div>
  </div>

  <!-- TABLE -->
  <div class="card table-card">
    <div class="table-head">
      <h2>Stock Levels</h2>
      <div style="font-size:12px;color:var(--muted);">
        <b>@Model.TotalItems</b> product@(Model.TotalItems != 1 ? "s" : "")
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Product</th>
            <th>Category</th>
            <th class="num">Qty Available</th>
            <th class="num">Qty Reserved</th>
            <th class="num">Reorder Level</th>
            <th>Location</th>
            <th>Status</th>
            <th>Last Updated</th>
          </tr>
        </thead>
        <tbody>
          @if (!Model.Rows.Any())
          {
            <tr><td colspan="8" class="empty">No inventory data found.</td></tr>
          }
          else
          {
            foreach (var row in Model.Rows)
            {
              <tr>
                <td><strong>@row.ProductName</strong></td>
                <td>@row.Category</td>
                <td class="num mono @(row.IsLowStock ? "qty-warn" : "")">@row.QuantityAvailable</td>
                <td class="num mono">@row.QuantityReserved</td>
                <td class="num mono">@row.ReorderLevel</td>
                <td>@row.Location</td>
                <td>
                  @if (row.IsLowStock)
                  {
                    <span class="badge badge-warn"><span class="dot"></span>LOW STOCK</span>
                  }
                  else
                  {
                    <span class="badge badge-ok"><span class="dot"></span>OK</span>
                  }
                </td>
                <td class="mono">@row.LastUpdated.ToString("yyyy-MM-dd")</td>
              </tr>
            }
          }
        </tbody>
      </table>
    </div>
  </div>

</div>
</body>
</html>
