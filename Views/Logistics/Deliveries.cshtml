@model IEnumerable<ISDN.Models.Delivery>

@{
    ViewData["Title"] = "Deliveries";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="fas fa-truck"></i> Deliveries</h2>
            <p class="text-muted">Filtered by RDC and status</p>
        </div>
    </div>

    <ul class="nav nav-tabs" id="deliveryTab" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#in-transit" type="button">In Transit</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#delivered" type="button">Delivered</button>
        </li>
    </ul>

    <div class="tab-content pt-4" id="deliveryTabContent">
        <div class="tab-pane fade show active" id="in-transit" role="tabpanel">
            <div class="card">
                <div class="card-body">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Delivery ID</th>
                                <th>Order ID</th>
                                <th>Driver</th>
                                <th>Status</th>
                                <th>Scheduled Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Where(x => x.Status != null && x.Status.Trim().Equals("In Transit", StringComparison.OrdinalIgnoreCase))
                                                        .OrderByDescending(x => x.ScheduledDate))
                            {
                                <tr>
                                    <td>@d.DeliveryId</td>
                                    <td>@d.OrderId</td>
                                    <td>@d.Driver?.FullName</td>
                                    <td><span class="badge bg-primary">@d.Status</span></td>
                                    <td>@d.ScheduledDate?.ToString("yyyy-MM-dd")</td>
                                    <td><a href="#" class="btn btn-sm btn-info"><i class="fas fa-eye"></i> View</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="delivered" role="tabpanel">
            <div class="card">
                <div class="card-body">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Delivery ID</th>
                                <th>Order ID</th>
                                <th>Driver</th>
                                <th>Status</th>
                                <th>Delivered Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Where(x => x.Status != null && x.Status.Trim().Equals("Delivered", StringComparison.OrdinalIgnoreCase))
                                                        .OrderByDescending(x => x.DeliveryDate))
                            {
                                <tr>
                                    <td>@d.DeliveryId</td>
                                    <td>@d.OrderId</td>
                                    <td>@d.Driver?.FullName</td>
                                    <td><span class="badge bg-success">@d.Status</span></td>
                                    <td>@d.DeliveryDate?.ToString("yyyy-MM-dd")</td>
                                    <td><a href="#" class="btn btn-sm btn-info"><i class="fas fa-eye"></i> View</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
