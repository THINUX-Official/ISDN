@{
    ViewData["Title"] = "RDC Staff Dashboard";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="fas fa-warehouse"></i> RDC Staff Dashboard</h2>
            <p class="text-muted">View Inventory, Manage Orders and Add Products</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center border-success">
                <div class="card-body">
                    <i class="fas fa-warehouse fa-3x text-success mb-3"></i>
                    <h3>@ViewBag.AvailableInventory</h3>
                    <p class="text-muted">Available Inventory</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-info">
                <div class="card-body">
                    <i class="fas fa-boxes fa-3x text-info mb-3"></i>
                    <h3>@ViewBag.MonthlyOrders</h3>
                    <p class="text-muted">Monthly Orders</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-primary">
                <div class="card-body">
                    <i class="fas fa-chart-line fa-3x text-primary mb-3"></i>
                    <h3>@ViewBag.SoldItems</h3>
                    <p class="text-muted">Sold Items</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-success">
                <div class="card-body">
                    <i class="fas fa-dollar-sign fa-3x text-success mb-3"></i>
                    <h3>@ViewBag.MonthlyRevenue</h3>
                    <p class="text-muted">Monthly Revenue</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Quick Actions Panel -->
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5><i class="fas fa-tasks"></i> Quick Actions</h5>
                </div>
                <style>
                                    .ghost-scroll-container {
                                        max-height: 165px;
                                        overflow-y: hidden;
                                    }
                                    .ghost-scroll-container:hover {
                                        overflow-y: auto;
                                    }
                                    /* Custom Scrollbar */
                                    .ghost-scroll-container::-webkit-scrollbar {
                                        width: 6px;
                                    }
                                    .ghost-scroll-container::-webkit-scrollbar-track {
                                        background: transparent;
                                    }
                                    .ghost-scroll-container::-webkit-scrollbar-thumb {
                                        background: rgba(0, 0, 0, 0.2);
                                        border-radius: 3px;
                                    }
                                    .ghost-scroll-container::-webkit-scrollbar-thumb:hover {
                                        background: rgba(0, 0, 0, 0.4);
                                    }
                </style>
                <div class="card-body ghost-scroll-container">
                    <a asp-action="Inventory" class="btn btn-outline-success w-100 mb-2">
                        <i class="fas fa-warehouse"></i> View Inventory
                    </a>
                    <a asp-action="Orders" class="btn btn-outline-info w-100 mb-2">
                        <i class="fas fa-shopping-cart"></i> View Orders
                    </a>
                    <a asp-controller="Products" asp-action="Manage" class="btn btn-outline-warning w-100 mb-2">
                        <i class="fas fa-plus-circle"></i> Add Product
                    </a>

                    <hr class="mt-2 mb-3" />

                    <a asp-controller="OrderLifecycle" asp-action="Index" class="btn btn-outline-primary w-100 mb-2">
                        <i class="fas fa-project-diagram"></i> View order lifecycles
                    </a>



                    <a asp-controller="ReturnProcessing" asp-action="ProcessReturns" class="btn btn-outline-warning w-100 mb-2">
                        <i class="fas fa-undo-alt"></i> Return Request Processing
                    </a>
                    <a asp-controller="ReturnProcessing" asp-action="PendingReturnsValidityCheck" class="btn btn-outline-info w-100 mb-2">
                        <i class="fas fa-clipboard-check"></i> Return Request Validity Check
                    </a>

                    <a asp-controller="StockTransfer" asp-action="StockManagement" class="btn btn-outline-secondary w-100 mb-2">
                        <i class="fas fa-truck-loading"></i> Stock Management
                    </a>

                   


