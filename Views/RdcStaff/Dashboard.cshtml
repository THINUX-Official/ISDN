@{
    ViewData["Title"] = "RDC Staff Dashboard";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="fas fa-warehouse"></i> RDC Staff Dashboard</h2>
            <p class="text-muted">View Inventory, Manage Orders and Add Products</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center border-success">
                <div class="card-body">
                    <i class="fas fa-warehouse fa-3x text-success mb-3"></i>
                    <h3>@ViewBag.AvailableInventory</h3>
                    <p class="text-muted">Available Inventory</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-info">
                <div class="card-body">
                    <i class="fas fa-boxes fa-3x text-info mb-3"></i>
                    <h3>@ViewBag.MonthlyOrders</h3>
                    <p class="text-muted">Monthly Orders</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-primary">
                <div class="card-body">
                    <i class="fas fa-chart-line fa-3x text-primary mb-3"></i>
                    <h3>@ViewBag.SoldItems</h3>
                    <p class="text-muted">Sold Items</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-success">
                <div class="card-body">
                    <i class="fas fa-dollar-sign fa-3x text-success mb-3"></i>
                    <h3>@ViewBag.MonthlyRevenue</h3>
                    <p class="text-muted">Monthly Revenue</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Quick Actions Panel -->
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5><i class="fas fa-tasks"></i> Quick Actions</h5>
                </div>
                <style>
                                    .ghost-scroll-container {
                                        max-height: 165px;
                                        overflow-y: hidden;
                                    }
                                    .ghost-scroll-container:hover {
                                        overflow-y: auto;
                                    }
                                    /* Custom Scrollbar */
                                    .ghost-scroll-container::-webkit-scrollbar {
                                        width: 6px;
                                    }
                                    .ghost-scroll-container::-webkit-scrollbar-track {
                                        background: transparent;
                                    }
                                    .ghost-scroll-container::-webkit-scrollbar-thumb {
                                        background: rgba(0, 0, 0, 0.2);
                                        border-radius: 3px;
                                    }
                                    .ghost-scroll-container::-webkit-scrollbar-thumb:hover {
                                        background: rgba(0, 0, 0, 0.4);
                                    }
                </style>
                <div class="card-body ghost-scroll-container">
                    <a asp-action="Inventory" class="btn btn-outline-success w-100 mb-2">
                        <i class="fas fa-warehouse"></i> View Inventory
                    </a>
                    <a asp-action="Orders" class="btn btn-outline-info w-100 mb-2">
                        <i class="fas fa-shopping-cart"></i> View Orders
                    </a>
                    <a asp-controller="Products" asp-action="Manage" class="btn btn-outline-warning w-100 mb-2">
                        <i class="fas fa-plus-circle"></i> Add Product
                    </a>

                    <hr class="mt-2 mb-3" />

                    <a asp-controller="OrderLifecycle" asp-action="Index" class="btn btn-outline-primary w-100 mb-2">
                        <i class="fas fa-project-diagram"></i> View order lifecycles
                    </a>



                    <a asp-controller="ReturnProcessing" asp-action="ProcessReturns" class="btn btn-outline-warning w-100 mb-2">
                        <i class="fas fa-undo-alt"></i> Return Request Processing
                    </a>
                    <a asp-controller="ReturnProcessing" asp-action="PendingReturnsValidityCheck" class="btn btn-outline-info w-100 mb-2">
                        <i class="fas fa-clipboard-check"></i> Return Request Validity Check
                    </a>

                    <hr class="mt-2 mb-3"/>

                    
                    <button class="btn btn-outline-primary w-100 mb-2" onclick="generateReplenishment()">
                        <i class="fas fa-sync-alt"></i> Stock Replenishment requests
                    </button>
                    <button class="btn btn-outline-primary w-100 mb-2" onclick="recommendTransfers()">
                        <i class="fas fa-truck-loading"></i> Inter-RDC Transfer Recommendations
                    </button>
                    <button class="btn btn-outline-primary w-100 mb-2" onclick="predictShortages()">
                        <i class="fas fa-chart-pie"></i> Shortage Prediction
                    </button>

                    <button class="btn btn-outline-danger w-100 mb-2" data-bs-toggle="modal" data-bs-target="#redistributeModal">
                        <i class="fas fa-share-alt"></i> Redistribute RDC Stock
                    </button>

                    <button class="btn btn-outline-secondary w-100 mb-2" data-bs-toggle="modal" data-bs-target="#packRequestModal">
                        <i class="fas fa-box-open"></i> Request Assisting RDC to Pack
                    </button>



                    <button class="btn btn-outline-dark w-100 mb-2" data-bs-toggle="modal" data-bs-target="#controlTowerModal">
                        <i class="fas fa-satellite-dish"></i> Open Live Control Tower
                    </button>

                    <!-- Stock Management moved into Quick Actions -->
                    <a asp-controller="StockTransfer" asp-action="StockManagement" class="btn btn-outline-secondary w-100 mb-2">
                        <i class="fas fa-truck-loading"></i> Stock Management
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modals for new behaviors can be appended here -->

<!-- Live Control Tower Modal -->
<div class="modal fade" id="controlTowerModal" tabindex="-1" aria-labelledby="controlTowerModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-dark text-white">
        <h5 class="modal-title" id="controlTowerModalLabel"><i class="fas fa-satellite-dish"></i> Live Control Tower</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <span class="badge bg-danger pulse-alert d-none mb-3" id="lowStockAlertBadge">Low Stock Alerts!</span>
        <div id="islandMap" class="text-center bg-light border p-4 mb-3" style="min-height: 200px; display: flex; flex-wrap: wrap; align-items: center; justify-content: center;">
            [Island Map Simulation: RDC Locations & Live Stock Visibility]
        </div>
        <div id="liveAlertsContainer">
            <h6><i class="fas fa-bell text-warning"></i> Recent Alerts & Notifications</h6>
            <ul class="list-group list-group-flush" id="alertsList">
                <li class="list-group-item text-muted small">No recent alerts.</li>
            </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Drop RDC Modal -->
<div class="modal fade" id="suspendRdcModal" tabindex="-1" aria-labelledby="suspendRdcModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form asp-action="SuspendRdc" method="post">
        <div class="modal-header">
          <h5 class="modal-title" id="suspendRdcModalLabel">Suspend RDC</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <div class="mb-3">
                <label for="suspendRdcId" class="form-label">RDC ID to Suspend</label>
                <input type="number" class="form-control" id="suspendRdcId" name="suspendRdcId" min="1" required>
            </div>
            <p class="text-danger small">Warning: Suspending an RDC means it cannot be operated until re-activated.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning">Suspend</button>
        </div>
      </form>
    </div>
  </div>
</div>
                    

                   

<!-- Add RDC Modal -->
<div class="modal fade" id="addRdcModal" tabindex="-1" aria-labelledby="addRdcModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form asp-action="AddRdc" method="post">
        <div class="modal-header">
          <h5 class="modal-title" id="addRdcModalLabel">Add New RDC</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <div class="mb-3">
                <label for="rdcName" class="form-label">RDC Name</label>
                <input type="text" class="form-control" id="rdcName" name="rdcName" required>
            </div>
            <div class="mb-3">
                <label for="region" class="form-label">Region</label>
                <input type="text" class="form-control" id="region" name="region" required>
            </div>
            <div class="mb-3">
                <label for="address" class="form-label">Address</label>
                <input type="text" class="form-control" id="address" name="address">
            </div>
            <div class="mb-3">
                <label for="contactNumber" class="form-label">Contact Number</label>
                <input type="text" class="form-control" id="contactNumber" name="contactNumber">
            </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Add RDC</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Pack Request Modal -->
<div class="modal fade" id="packRequestModal" tabindex="-1" aria-labelledby="packRequestModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="packRequestForm">
        <div class="modal-header">
          <h5 class="modal-title" id="packRequestModalLabel">Request Assisting RDC to Pack Order</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <div class="mb-3">
                <label for="orderId" class="form-label">Pending Order ID</label>
                <input type="number" class="form-control" id="orderId" min="1" required>
            </div>
            <div class="mb-3">
                <label for="assistingRdcId" class="form-label">Assisting RDC</label>
                <select class="form-select" id="assistingRdcId" required>
                    <option value="">Loading RDCs...</option>
                </select>
            </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-success" id="sendPackRequestBtn">Send Request</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Redistribute Modal -->
<div class="modal fade" id="redistributeModal" tabindex="-1" aria-labelledby="redistributeModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="redistributeModalLabel">Redistribute RDC Stock</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
            <label for="selectInactiveRdc" class="form-label">Select Inactive RDC to Liquidate</label>
            <select id="selectInactiveRdc" class="form-select">
                <option value="">Loading inactive RDCs...</option>
            </select>
        </div>
        <div id="inactiveRdcProducts" class="mt-3" style="max-height:300px; overflow:auto; display:none;">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="confirmRedistributeBtn">Confirm Redistribute</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            fetchLiveAlerts();
            setInterval(fetchLiveAlerts, 60000); // refresh every minute

            fetchMapData();
        });

        function fetchLiveAlerts() {
            $.get('@Url.Action("GetLiveAlerts", "RdcStaff")', function(res) {
                if (res.success && res.alerts.length > 0) {
                    $('#lowStockAlertBadge').removeClass('d-none');
                    const alertHtml = res.alerts.map(a => `<li class="list-group-item text-danger small"><i class="fas fa-exclamation-triangle"></i> ${a}</li>`).join('');
                    $('#alertsList').html(alertHtml);
                    
                    // Trigger free notification (e.g., using OneSignal or simple browser notification API if permitted)
                    if (Notification && Notification.permission !== "granted") {
                        Notification.requestPermission();
                    } else if (Notification && Notification.permission === "granted") {
                        new Notification("RDC Alert", { body: res.alerts[0] });
                    }
                } else {
                    $('#lowStockAlertBadge').addClass('d-none');
                    $('#alertsList').html('<li class="list-group-item text-muted small">No recent alerts. Stock is healthy.</li>');
                }
            });
        }

        function fetchMapData() {
            $.get('@Url.Action("GetMapData", "RdcStaff")', function(res) {
                if(res.success) {
                    let mapHtml = '';
                    res.rdcs.forEach(r => {
                        let badgeClass = r.isCurrent ? "bg-primary" : "bg-secondary";
                        mapHtml += `<span class="badge ${badgeClass} m-1" style="font-size: 14px;"><i class="fas fa-map-marker-alt"></i> ${r.name} (${r.id})</span>`;
                    });
                    $('#islandMap').html(`<div><h6 class="text-muted mb-3">Live RDC Centers</h6>${mapHtml}</div>`);
                }
            });
        }

        function generateReplenishment() {
            $.post('@Url.Action("GenerateReplenishment", "RdcStaff")', function(res) {
                if (res.success) {
                    alert(res.message);
                } else {
                    alert("Failed to auto-generate replenishment.");
                }
            });
        }

        function recommendTransfers() {
            $.get('@Url.Action("RecommendTransfers", "RdcStaff")', function(res) {
                if (res.success && res.recommendations.length > 0) {
                    let msg = "Transfer Recommendations:\n\n";
                    res.recommendations.forEach(r => {
                        msg += `- Request ${r.suggestedQuantity} of '${r.product}' from ${r.fromRdc}\n`;
                    });
                    alert(msg);
                } else {
                    alert("No transfer recommendations available at this time.");
                }
            });
        }

        function predictShortages() {
            $.get('@Url.Action("PredictShortages", "RdcStaff")', function(res) {
                if (res.success && res.predictions.length > 0) {
                    let msg = "Shortage Predictions:\n\n";
                    res.predictions.forEach(p => {
                        msg += `- ${p.product} (est. out of stock in ${p.daysToStockout} days)\n`;
                    });
                    alert(msg);
                } else {
                    alert("Stock levels appear healthy. No imminent shortages.");
                }
            });
        }

        // Legacy redistribute action removed in favor of modal-based flow
                function redistributeStock() {
                    $('#redistributeModal').modal('show');
                }

        function submitPackRequest() {
            const orderId = $('#orderId').val();
            const targetId = $('#assistingRdcId').val();
            // Use RdcAssistance SendRequest which sends formatted email via SMTP
            $.post('@Url.Action("SendRequest", "RdcAssistance")', { orderId: orderId, targetRdcId: targetId }, function(res) {
                if(res.success) {
                    alert(res.message);
                    $('#packRequestModal').modal('hide');
                } else {
                    alert(res.message);
                }
            });
        }

        // New JS: populate assisting RDC dropdown when modal opens
        $('#packRequestModal').on('show.bs.modal', function () {
            var select = $('#assistingRdcId');
            select.empty();
            select.append('<option value="">Loading RDCs...</option>');
            $.get('@Url.Action("Index", "RdcAssistance")', function() {
                // Call backend endpoint to get list of active RDCs from RdcAssistance Index view model
                $.get('@Url.Action("GetMapData", "RdcStaff")', function(res) {
                    select.empty();
                    if (res.success && res.rdcs.length > 0) {
                        select.append('<option value="">Select RDC</option>');
                        res.rdcs.forEach(function(r){
                            if(!r.isCurrent) select.append('<option value="'+r.id+'">'+r.name+' ('+r.id+')</option>');
                        });
                    } else {
                        select.append('<option value="">No RDCs available</option>');
                    }
                });
            });
        });

        $('#sendPackRequestBtn').on('click', function(e) {
            e.preventDefault();
            submitPackRequest();
        });

        // Redistribute modal logic
        $('#redistributeModal').on('show.bs.modal', function() {
            var sel = $('#selectInactiveRdc');
            sel.empty();
            sel.append('<option value="">Loading inactive RDCs...</option>');
            $.get('@Url.Action("GetInactiveRdcs", "RdcStaff")', function(res){
                sel.empty();
                if(res.success && res.rdcs.length>0){
                    sel.append('<option value="">Select RDC</option>');
                    res.rdcs.forEach(function(r){ sel.append('<option value="'+r.id+'">'+r.name+' ('+r.id+')</option>'); });
                } else {
                    sel.append('<option value="">No inactive RDCs found</option>');
                }
            });
        });

        $('#selectInactiveRdc').on('change', function(){
            var id = $(this).val();
            var container = $('#inactiveRdcProducts');
            if(!id){ container.hide(); return; }
            container.show();
            container.html('<p>Loading products...</p>');
            $.get('@Url.Action("GetRdcProducts", "RdcStaff")', { rdcId: id }, function(res){
                if(res.success){
                    var html = '<table class="table"><thead><tr><th>Product</th><th>Available</th><th>Reserved</th></tr></thead><tbody>';
                    res.products.forEach(function(p){ html += '<tr><td>'+p.productName+'</td><td>'+p.available+'</td><td>'+p.reserved+'</td></tr>'; });
                    html += '</tbody></table>';
                    container.html(html);
                } else {
                    container.html('<p>No products found.</p>');
                }
            });
        });

        $('#confirmRedistributeBtn').on('click', function(){
            var id = $('#selectInactiveRdc').val();
            if(!id){ alert('Please select an RDC to redistribute.'); return; }
            if(!confirm('This will redistribute all available stock from the selected inactive RDC to active RDCs. Continue?')) return;
            $.post('@Url.Action("RedistributeStock", "RdcStaff")', { dropRdcId: id }, function(){
                alert('Stock redistribution initiated.');
                location.reload();
            });
        });
    </script>
}
