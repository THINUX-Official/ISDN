@model ISDN.ViewModels.InventoryViewModel

@{
    ViewData["Title"] = "Inventory Management";
}

<style>
    .filter-btn {
        margin-right: 5px;
        border-radius: 5px;
        padding: 6px 15px;
        border: none;
        cursor: pointer;
        font-size: 14px;
    }
    .filter-btn.active {
        box-shadow: 0 0 10px rgba(0,0,0,0.2);
    }
    .filter-all {
        background-color: #6c757d;
        color: white;
    }
    .filter-damage {
        background-color: #dc3545;
        color: white;
    }
    .filter-return {
        background-color: #ffc107;
        color: black;
    }
    .search-container {
        position: relative;
        max-width: 400px;
    }
    .search-container input {
        padding-right: 35px;
    }
    .search-clear {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #999;
    }
    .modal {
        display: none;
        position: fixed;
        z-index: 1050;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0,0,0,0.4);
    }
    .modal-content {
        background-color: #fefefe;
        margin: 5% auto;
        border-radius: 8px;
        width: 90%;
        max-width: 600px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
    .modal-header {
        background-color: #17a2b8;
        color: white;
        padding: 15px 20px;
        border-radius: 8px 8px 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .modal-header h5 {
        margin: 0;
        font-size: 18px;
    }
    .modal-close {
        color: white;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
        background: none;
        border: none;
    }
    .modal-body {
        padding: 20px;
    }
    .modal-footer {
        padding: 15px 20px;
        border-top: 1px solid #dee2e6;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }
    .stock-display {
        background-color: #f8f9fa;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-around;
    }
    .stock-item {
        text-align: center;
    }
    .stock-label {
        color: #6c757d;
        font-size: 12px;
        margin-bottom: 5px;
    }
    .stock-value {
        font-size: 32px;
        font-weight: bold;
        color: #17a2b8;
    }
    .form-section {
        margin-bottom: 20px;
        padding: 15px;
        border: 1px solid #dee2e6;
        border-radius: 5px;
    }
    .form-section h6 {
        margin-bottom: 15px;
        color: #495057;
    }
    .add-quantity-group {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .add-btn {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 8px 15px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 18px;
    }
</style>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="fas fa-warehouse"></i> Inventory</h2>
            <p class="text-muted">View and manage product inventory</p>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <!-- Search and Filter Section -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="search-container">
                        <input type="text" id="searchBox" class="form-control" placeholder="Search by Product Name, Location or Status...">
                        <span class="search-clear" id="clearSearch">✕</span>
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <label class="me-2">Filter:</label>
                    <button class="filter-btn filter-all active" data-filter="all"><i class="fas fa-th-list"></i> All</button>
                    <button class="filter-btn filter-damage" data-filter="damage"><i class="fas fa-exclamation-triangle"></i> Damage</button>
                    <button class="filter-btn filter-return" data-filter="return"><i class="fas fa-undo"></i> Return</button>
                </div>
            </div>

            <!-- Inventory Table -->
            @if (Model.NormalStock != null && Model.NormalStock.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover" id="inventoryTable">
                        <thead>
                            <tr>
                                <th>Inventory ID</th>
                                <th>Product Name</th>
                                <th>Location</th>
                                <th>Available</th>
                                <th>Reserved</th>
                                <th>Reorder Level</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.NormalStock)
                            {
                                <tr data-location="@item.Location" data-product="@item.ProductName" data-status="@item.StockStatusText">
                                    <td>@item.InventoryId</td>
                                    <td>@item.ProductName</td>
                                    <td>@item.Location</td>
                                    <td>@item.QuantityAvailable</td>
                                    <td>@item.QuantityReserved</td>
                                    <td>@item.ReorderLevel</td>
                                    <td>
                                        <span class="badge bg-@item.StockStatusClass">@item.StockStatusText</span>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-info text-white edit-stock-btn"
                                                data-inventory-id="@item.InventoryId">
                                            <i class="fas fa-edit"></i> Edit Stock
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3">
                    <button class="btn btn-secondary" onclick="window.print();">
                        <i class="fas fa-file-alt"></i> Report
                    </button>
                </div>
            }
            else
            {
                <p class="text-center text-muted py-5">No inventory found</p>
            }
        </div>
    </div>

    <!-- Quarantine Stock Section -->
    @if (Model.QuarantineStock != null && Model.QuarantineStock.Any())
    {
        <div class="card mt-4 border-warning">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0"><i class="fas fa-exclamation-triangle"></i> Quarantine Stock (Returns Hold)</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="fas fa-info-circle"></i> These items are from returned orders and awaiting inspection.
                </div>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>SKU</th>
                                <th>Category</th>
                                <th>Quantity</th>
                                <th>Location</th>
                                <th>Last Updated</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.QuarantineStock)
                            {
                                <tr>
                                    <td><strong>@item.ProductName</strong></td>
                                    <td>@item.ProductCode</td>
                                    <td>@item.Category</td>
                                    <td><span class="badge bg-danger">@item.QuantityAvailable</span></td>
                                    <td><span class="badge bg-warning text-dark">@item.Location</span></td>
                                    <td>@item.LastUpdated.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        <form asp-action="ApproveQuarantineStock" method="post" class="d-inline">
                                            <input type="hidden" name="inventoryId" value="@item.InventoryId" />
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success"
                                                    onclick="return confirm('Move this stock back to normal inventory?')">
                                                <i class="fas fa-check"></i> Approve
                                            </button>
                                        </form>
                                        <form asp-action="DisposeQuarantineStock" method="post" class="d-inline">
                                            <input type="hidden" name="inventoryId" value="@item.InventoryId" />
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Permanently dispose this stock? This cannot be undone!')">
                                                <i class="fas fa-trash"></i> Dispose
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- Edit Stock Modal -->
<div id="editStockModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h5><i class="fas fa-edit"></i> Edit Inventory Stock</h5>
            <button class="modal-close">&times;</button>
        </div>
        <div class="modal-body">
            <div class="mb-3">
                <label class="form-label">Product</label>
                <h5 id="modalProductName">-</h5>
            </div>

            <div class="stock-display">
                <div class="stock-item">
                    <div class="stock-label">Current Available</div>
                    <div class="stock-value" id="currentAvailable">0</div>
                </div>
                <div class="stock-item">
                    <div class="stock-label">Current Reserved</div>
                    <div class="stock-value" id="currentReserved">0</div>
                </div>
            </div>

            <form id="editStockForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editInventoryId" name="inventoryId" />

                <div class="form-section">
                    <h6><i class="fas fa-plus-circle text-success"></i> Add to Available Quantity</h6>
                    <div class="add-quantity-group">
                        <button type="button" class="add-btn" id="addBtn">+</button>
                        <input type="number" class="form-control" id="addQuantity" name="addQuantity" value="0" min="0" />
                    </div>
                    <small class="text-muted mt-2 d-block">New Available Total: <strong id="newAvailableTotal">0</strong></small>
                </div>

                <div class="form-section">
                    <h6><i class="fas fa-lock text-warning"></i> Update Reserved Quantity</h6>
                    <input type="number" class="form-control" id="newReserved" name="newReserved" value="0" min="0" />
                    <small class="text-muted mt-2 d-block">This replaces the current reserved value.</small>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" id="cancelBtn">
                <i class="fas fa-times"></i> Cancel
            </button>
            <button type="button" class="btn btn-primary" id="saveChangesBtn">
                <i class="fas fa-save"></i> Save Changes
            </button>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <script>
        alert('@TempData["SuccessMessage"]');
    </script>
}

@if (TempData["Error"] != null)
{
    <script>
        alert('@TempData["Error"]');
    </script>
}

<script>
    // Modal functionality
    const modal = document.getElementById('editStockModal');
    const closeBtn = document.querySelector('.modal-close');
    const cancelBtn = document.getElementById('cancelBtn');
    const saveBtn = document.getElementById('saveChangesBtn');
    const addBtn = document.getElementById('addBtn');

    // Edit Stock button click
    document.querySelectorAll('.edit-stock-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const inventoryId = this.getAttribute('data-inventory-id');
            loadStockData(inventoryId);
        });
    });

    // Load stock data via AJAX
    function loadStockData(inventoryId) {
        fetch(`/RdcStaff/GetStockForEdit?inventoryId=${inventoryId}`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('editInventoryId').value = data.inventoryId;
                    document.getElementById('modalProductName').textContent = data.productName;
                    document.getElementById('currentAvailable').textContent = data.available;
                    document.getElementById('currentReserved').textContent = data.reserved;
                    document.getElementById('addQuantity').value = 0;
                    document.getElementById('newReserved').value = data.reserved;
                    updateNewTotal();
                    modal.style.display = 'block';
                } else {
                    alert(data.message || 'Error loading stock data');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error loading stock data');
            });
    }

    // Update new total calculation
    function updateNewTotal() {
        const current = parseInt(document.getElementById('currentAvailable').textContent);
        const add = parseInt(document.getElementById('addQuantity').value) || 0;
        document.getElementById('newAvailableTotal').textContent = current + add;
    }

    document.getElementById('addQuantity').addEventListener('input', updateNewTotal);

    addBtn.addEventListener('click', function() {
        const input = document.getElementById('addQuantity');
        input.value = parseInt(input.value) + 1;
        updateNewTotal();
    });

    // Close modal
    closeBtn.addEventListener('click', () => modal.style.display = 'none');
    cancelBtn.addEventListener('click', () => modal.style.display = 'none');
    window.addEventListener('click', (e) => {
        if (e.target == modal) modal.style.display = 'none';
    });

    // Save changes
    saveBtn.addEventListener('click', function() {
        const formData = new FormData(document.getElementById('editStockForm'));

        fetch('/RdcStaff/UpdateStock', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                modal.style.display = 'none';
                location.reload();
            } else {
                alert(data.message || 'Error updating stock');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error updating stock');
        });
    });

    // Search functionality
    const searchBox = document.getElementById('searchBox');
    const clearSearch = document.getElementById('clearSearch');
    const table = document.getElementById('inventoryTable');

    searchBox.addEventListener('input', function() {
        const searchTerm = this.value.toLowerCase();
        filterTable(searchTerm, currentFilter);
    });

    clearSearch.addEventListener('click', function() {
        searchBox.value = '';
        filterTable('', currentFilter);
    });

    // Filter functionality
    let currentFilter = 'all';
    const filterBtns = document.querySelectorAll('.filter-btn');

    filterBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            filterBtns.forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            currentFilter = this.getAttribute('data-filter');
            filterTable(searchBox.value.toLowerCase(), currentFilter);
        });
    });

    function filterTable(searchTerm, filter) {
        const rows = table.querySelectorAll('tbody tr');

        rows.forEach(row => {
            const location = (row.getAttribute('data-location') || '').toLowerCase();
            const product = (row.getAttribute('data-product') || '').toLowerCase();
            const status = (row.getAttribute('data-status') || '').toLowerCase();

            const matchesSearch = product.includes(searchTerm) || 
                                  location.includes(searchTerm) || 
                                  status.includes(searchTerm);

            let matchesFilter = true;
            if (filter === 'damage') {
                matchesFilter = location.includes('damage');
            } else if (filter === 'return') {
                matchesFilter = location.includes('return');
            }

            if (matchesSearch && matchesFilter) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }
</script>
